{
  "name": "fark-study-engine",
  "version": "0.2.0",
  "description": "A tiny, dependency-free, offline-first spaced review engine for learning tools.",
  "type": "module",
  "types": "./types/index.d.ts",
  "bin": {
    "fark": "./bin/fark.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./planner": {
      "types": "./types/planner.d.ts",
      "default": "./src/planner.js"
    },
    "./portable": {
      "types": "./types/portable.d.ts",
      "default": "./src/portable.js"
    },
    "./csv": {
      "types": "./types/csv.d.ts",
      "default": "./src/csv.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "demo": "node examples/demo.js",
    "demo:planner": "node examples/session-planning.js",
    "demo:web": "node examples/serve-web.js"
  },
  "license": "MIT",
  "keywords": [
    "learning",
    "spaced-review",
    "flashcards",
    "offline",
    "education"
  ]
}
