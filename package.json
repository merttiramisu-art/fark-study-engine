{
  "name": "fark-study-engine",
  "version": "0.7.0",
  "description": "Zero-dependency, offline-first Learning Ledger, DSR memory calibration, prerequisite cognitive diagnosis, closed-loop MCP server & English/STEM study studio.",
  "repository": {
    "type": "git",
    "url": "https://github.com/merttiramisu-art/fark-study-engine.git"
  },
  "homepage": "https://github.com/merttiramisu-art/fark-study-engine#readme",
  "bugs": {
    "url": "https://github.com/merttiramisu-art/fark-study-engine/issues"
  },
  "type": "module",
  "types": "./types/index.d.ts",
  "bin": {
    "fark": "./bin/fark.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./planner": {
      "types": "./types/planner.d.ts",
      "default": "./src/planner.js"
    },
    "./portable": {
      "types": "./types/portable.d.ts",
      "default": "./src/portable.js"
    },
    "./csv": {
      "types": "./types/csv.d.ts",
      "default": "./src/csv.js"
    },
    "./markdown": {
      "types": "./types/markdown.d.ts",
      "default": "./src/markdown.js"
    },
    "./strategies": {
      "types": "./types/strategies.d.ts",
      "default": "./src/strategies.js"
    },
    "./interchange": {
      "types": "./types/interchange.d.ts",
      "default": "./src/interchange.js"
    },
    "./widget": {
      "types": "./types/widget.d.ts",
      "default": "./src/widget.js"
    },
    "./mcp": {
      "types": "./types/mcp.d.ts",
      "default": "./src/mcp.js"
    },
    "./memory": {
      "types": "./types/memory.d.ts",
      "default": "./src/memory.js"
    },
    "./ledger": {
      "types": "./types/ledger.d.ts",
      "default": "./src/ledger.js"
    },
    "./diagnosis": {
      "types": "./types/diagnosis.d.ts",
      "default": "./src/diagnosis.js"
    },
    "./calibrate": {
      "types": "./types/calibrate.d.ts",
      "default": "./src/calibrate.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "demo": "node examples/demo.js",
    "demo:planner": "node examples/session-planning.js",
    "demo:web": "node examples/serve-web.js",
    "demo:english": "node examples/english-closed-loop.js"
  },
  "license": "MIT",
  "keywords": [
    "learning-infrastructure",
    "spaced-repetition",
    "fsrs",
    "dsr",
    "sm2",
    "cognitive-diagnosis",
    "mcp-server",
    "english-learning",
    "event-sourcing",
    "offline-first",
    "zero-dependencies"
  ]
}
